<?xml version="1.0" encoding="utf-8"?>
<!-- Ambient mesh backdrop that the frosted glass panels float above. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_base" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:centerX="0.16"
                android:centerY="0.10"
                android:startColor="@color/bg_mesh_1"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="65%p"
                android:centerX="0.88"
                android:centerY="0.20"
                android:startColor="@color/bg_mesh_2"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="70%p"
                android:centerX="0.50"
                android:centerY="0.95"
                android:startColor="@color/bg_mesh_3"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>

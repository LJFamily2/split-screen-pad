    <!-- Native split step-by-step guide overlay -->
    <string name="native_guide_title">How to open two apps side by side</string>
    <string name="native_guide_subtitle">Android requires your device to already be in split-screen before a second app can open alongside it. Follow these steps:</string>
    <string name="native_guide_step1">Tap “Open both apps” — %1$s will launch first.</string>
    <string name="native_guide_step2">Hold the app’s title bar (or use the Recents key) and drag it to one side of the screen until the split-screen divider appears.</string>
    <string name="native_guide_step3">%2$s will appear in the app picker. Tap it to fill the other half.</string>
    <string name="native_guide_tip">Tip: You can also long-press an app in your Recents screen and choose “Split screen” on supported devices.</string>
